---
/**
 * Tarjeta de viaje por defecto del carrusel. Usa solo tokens del tema, así se
 * ve bien en los 4; un tema puede pasar su propia tarjeta a <TripCarousel card={…}>.
 */
import { Picture } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { days, shortDate, usd } from '@/lib/format';
import { tripPhoto } from '@/lib/images';

export interface Props {
  trip: CollectionEntry<'trips'>;
  index: number;
}
const { trip, index } = Astro.props;
const { data } = trip;
const img = tripPhoto(trip.id);
---

<article class="card">
  <div class="media">
    <Picture
      src={img.src}
      alt={img.alt}
      formats={['avif', 'webp']}
      fallbackFormat="webp"
      width={760}
      widths={[380, 760]}
      sizes="(min-width: 1024px) 380px, 80vw"
      loading={index < 3 ? 'eager' : 'lazy'}
      pictureAttributes={{ class: 'pic' }}
    />
    {data.tag && <span class="tag">{data.tag}</span>}
  </div>
  <div class="body">
    <p class="meta">{data.region} · {days(data.days)} · Exigencia {data.difficulty.toLowerCase()}</p>
    <h3 class="title">{data.title}</h3>
    <p class="desc">{data.description}</p>
    <p class="foot">
      <span>Sale el {shortDate(data.nextDeparture)} · {data.seatsLeft} cupos</span>
      <span class="price">desde <strong>{usd(data.priceFrom)}</strong></span>
    </p>
  </div>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    background: var(--card);
  }
  .media {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }
  .media :global(.pic),
  .media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s var(--ease);
  }
  .card:hover .media :global(img) {
    transform: scale(1.05);
  }
  .tag {
    position: absolute;
    top: 12px;
    left: 12px;
    padding: 4px 12px;
    border-radius: var(--radius);
    background: var(--accent);
    color: var(--on-accent);
    font-family: var(--f-mono);
    font-size: 12px;
  }
  .body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 8px;
    padding: 20px;
  }
  .meta {
    font-family: var(--f-mono);
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .title {
    font-family: var(--f-display);
    font-size: 1.6rem;
    font-weight: 700;
    line-height: 1.05;
  }
  .desc {
    color: var(--ink-2);
    font-size: 15px;
  }
  .foot {
    margin-top: auto;
    padding-top: 12px;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 4px 16px;
    font-size: 14px;
    color: var(--muted);
  }
  .price {
    font-family: var(--f-mono);
    font-size: 15px;
    color: var(--ink);
    white-space: nowrap;
  }
</style>
