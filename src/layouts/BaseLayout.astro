---
/**
 * Esqueleto HTML común. Cada tema lo envuelve en themes/<tema>/Layout.astro,
 * que importa sus tokens y fuentes (así cada ruta solo carga el CSS de su tema).
 */
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';
import Chat from '@/components/shared/Chat.astro';
import Footer from '@/components/shared/Footer.astro';
import ThemeSwitcher from '@/components/shared/ThemeSwitcher.astro';
import { AGENCY } from '@/lib/catalog';
import { THEMES, type ThemeId } from '@/lib/themes';
import '@/styles/global.css';

interface Props {
  theme: ThemeId;
  title?: string;
  description?: string;
  /** Muestra el chat flotante de preguntas frecuentes */
  chat?: boolean;
}

const {
  theme,
  chat = false,
  title = `${AGENCY.name} — Trekking guiado en la Patagonia`,
  description = `${AGENCY.motto}. Trekking guiado en la Patagonia chilena en grupos de máximo ${AGENCY.maxGroup} personas, con guías locales y todo incluido.`,
} = Astro.props;
const meta = THEMES[theme];
const canonical = new URL(Astro.url.pathname, Astro.site);

// Imagen para compartir: src/assets/img/shared/og-<tema>.(jpg|webp), exportada a JPG 1200×630
const ogFiles = import.meta.glob<{ default: ImageMetadata }>('../assets/img/shared/og-*.{jpg,webp}', { eager: true });
const ogSrc = Object.entries(ogFiles).find(([path]) => path.includes(`/og-${theme}.`))?.[1].default;
const og = ogSrc ? await getImage({ src: ogSrc, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 82 }) : undefined;
---

<!doctype html>
<html lang="es-CL" data-theme={theme} style={`color-scheme:${meta.colorScheme}`}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content={meta.themeColor} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_CL" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {
      og && (
        <>
          <meta property="og:image" content={new URL(og.src, Astro.site)} />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta name="twitter:card" content="summary_large_image" />
        </>
      )
    }
    <meta name="generator" content={Astro.generator} />
    <ClientRouter fallback="swap" />
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <slot />
    <Footer />
    {chat && <Chat />}
    <ThemeSwitcher current={theme} />
  </body>
</html>
