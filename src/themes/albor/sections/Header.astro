---
/**
 * Header flotante de Albor: barra de vidrio con indicador deslizante en el
 * menú, próxima salida, "me gusta" y barra de progreso. En móvil el menú se
 * abre con un botón (disclosure).
 */
import LikeButton from '@/components/shared/LikeButton.astro';
import { AGENCY } from '@/lib/catalog';
import { NAV } from '../data';

interface Props {
  /** "Torres del Paine · 18 nov · 4 cupos" */
  next: string;
}
const { next } = Astro.props;
---

<header class="hdr" data-hdr>
  <div class="wrap">
    <div class="bar">
      <a href="#planear" class="logo" aria-label={`${AGENCY.name}, inicio`} transition:name="brand">
        <span class="mark" aria-hidden="true">
          <svg viewBox="0 0 32 32" fill="none">
            <path d="M3 25L11.5 10l4.5 7 3.5-5 9.5 13z" stroke="#fff" stroke-width="2.2" stroke-linejoin="round"></path>
            <path d="M7 19.5c3.5-2.6 7 2.6 10.5 0s6-1.8 8 .8" stroke="#C9F27A" stroke-width="2.2" stroke-dasharray="2.4 2.4" stroke-linecap="round"></path>
          </svg>
        </span>
        <span class="word">{AGENCY.name.toLowerCase()}<small>trekking · patagonia</small></span>
      </a>
      <nav class="nav" id="al-nav" aria-label="Principal" data-nav>
        <span class="ind" aria-hidden="true" data-ind></span>
        {NAV.map(([href, label]) => <a href={href} data-sec={href.slice(1)}>{label}</a>)}
      </nav>
      <div class="tools">
        <a class="next" href="#resultados">
          <i aria-hidden="true"></i>
          <span><small>Próxima salida</small>{next}</span>
        </a>
        <LikeButton class="pill" />
        <a class="cta" href="#resultados">
          Reservar<span aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M7 17L17 7M9 7h8v8"></path></svg></span>
        </a>
        <button class="menu" type="button" aria-expanded="false" aria-controls="al-nav" data-menu>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
          <span class="sr-only">Menú</span>
        </button>
      </div>
    </div>
    <div class="prog" aria-hidden="true" data-progress></div>
  </div>
</header>

<style>
  .hdr {
    position: fixed;
    top: 12px;
    left: 0;
    right: 0;
    z-index: 50;
    transition: top 0.4s var(--ease);
  }
  .hdr:global(.solid) {
    top: 8px;
  }
  .wrap {
    position: relative;
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    height: 68px;
    padding: 0 10px 0 12px;
    border-radius: 22px;
    background: rgb(255 255 255 / 0.72);
    border: 1px solid rgb(255 255 255 / 0.9);
    -webkit-backdrop-filter: blur(18px) saturate(1.5);
    backdrop-filter: blur(18px) saturate(1.5);
    box-shadow:
      0 1px 0 rgb(22 21 29 / 0.04),
      0 18px 40px -26px rgb(22 21 29 / 0.35);
    transition:
      height 0.4s var(--ease),
      box-shadow 0.4s;
  }
  .hdr:global(.solid) .bar {
    height: 60px;
    box-shadow:
      0 1px 0 rgb(22 21 29 / 0.05),
      0 22px 50px -24px rgb(91 75 232 / 0.45);
  }
  .prog {
    position: absolute;
    left: 34px;
    right: 34px;
    bottom: 0;
    height: 2px;
    border-radius: 2px;
    background: linear-gradient(90deg, var(--accent), var(--accent-2));
    transform-origin: 0 50%;
    transform: scaleX(0);
  }
  .logo {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
  }
  .mark {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 13px;
    background: var(--accent);
    box-shadow: inset 0 -6px 12px rgb(0 0 0 / 0.15);
    transition: transform 0.5s var(--ease);
  }
  .logo:hover .mark {
    transform: rotate(-8deg) scale(1.05);
  }
  .mark svg {
    width: 26px;
    height: 26px;
  }
  .word {
    font-family: var(--f-display);
    font-weight: 800;
    font-size: 21px;
    letter-spacing: -0.02em;
    line-height: 1;
  }
  .word small {
    display: block;
    margin-top: 3px;
    font-family: var(--f-mono);
    font-weight: 400;
    font-size: 9.5px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .nav {
    position: relative;
    display: none;
    gap: 2px;
    padding: 4px;
    border-radius: 14px;
    background: rgb(22 21 29 / 0.04);
  }
  .nav a {
    position: relative;
    z-index: 1;
    padding: 9px 16px;
    border-radius: 11px;
    font-size: 14.5px;
    font-weight: 500;
    color: var(--ink-2);
    text-decoration: none;
    transition: color 0.3s;
  }
  .nav a:global(.on),
  .nav a:hover {
    color: var(--ink);
  }
  .ind {
    position: absolute;
    z-index: 0;
    top: 4px;
    bottom: 4px;
    left: 0;
    width: 0;
    border-radius: 11px;
    background: #fff;
    box-shadow: 0 4px 14px -6px rgb(22 21 29 / 0.3);
    opacity: 0;
    transition:
      transform 0.45s var(--ease),
      width 0.45s var(--ease),
      opacity 0.3s;
  }
  .tools {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .next {
    display: none;
    align-items: center;
    gap: 10px;
    padding: 6px 14px 6px 10px;
    border-radius: 12px;
    background: var(--soft);
    font-size: 13px;
    font-weight: 500;
    line-height: 1.2;
    text-decoration: none;
    transition: background-color 0.3s;
  }
  .next:hover {
    background: var(--soft-hover);
  }
  .next small {
    display: block;
    font-family: var(--f-mono);
    font-size: 9.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .next i {
    position: relative;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #5fa83a;
  }
  .next i::after {
    content: '';
    position: absolute;
    inset: -4px;
    border-radius: 50%;
    border: 2px solid #5fa83a;
    animation: ping 1.8s infinite;
  }
  @keyframes ping {
    from {
      transform: scale(0.6);
      opacity: 1;
    }
    to {
      transform: scale(1.8);
      opacity: 0;
    }
  }
  .hdr :global(.pill) {
    display: none;
    min-height: 42px;
    border-radius: 12px;
    background: #fff;
  }
  .hdr :global(.pill svg) {
    color: var(--accent);
  }
  .menu {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: var(--soft);
  }
  .menu svg {
    width: 22px;
    height: 22px;
  }
  @media (max-width: 520px) {
    .word small {
      display: none;
    }
    .cta {
      display: none;
    }
  }
  @media (min-width: 600px) {
    .hdr :global(.pill) {
      display: inline-flex;
    }
  }
  @media (min-width: 960px) {
    .nav {
      display: flex;
    }
    .menu {
      display: none;
    }
  }
  @media (min-width: 1180px) {
    .next {
      display: inline-flex;
    }
  }
  /* Menú abierto en móvil */
  @media (max-width: 959px) {
    .nav:global(.open) {
      position: absolute;
      top: 76px;
      left: 0;
      right: 0;
      display: grid;
      gap: 2px;
      padding: 8px;
      border-radius: 20px;
      background: #fff;
      border: 1px solid var(--line);
      box-shadow: 0 24px 50px -24px rgb(22 21 29 / 0.4);
    }
    .nav:global(.open) a {
      padding: 14px 16px;
      font-size: 17px;
    }
    .nav:global(.open) .ind {
      display: none;
    }
  }
</style>
