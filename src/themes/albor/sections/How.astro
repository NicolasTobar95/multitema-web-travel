---
/** "Reservar es simple": 4 pasos con foto y la banda de lo incluido (con parallax). */
import { Image, Picture } from 'astro:assets';
import incluido from '@/assets/img/albor/incluido.jpg';
import paso1 from '@/assets/img/albor/paso-1-elige.jpg';
import paso2 from '@/assets/img/albor/paso-2-reserva.jpg';
import paso3 from '@/assets/img/albor/paso-3-preparate.jpg';
import paso4 from '@/assets/img/albor/paso-4-camina.jpg';
import { INCLUDED, STEPS } from '../data';
import { icon } from '../images';

const photos = [paso1, paso2, paso3, paso4];
---

<section class="how" id="como" aria-labelledby="como-title">
  <div class="wrap">
    <div class="head">
      <div class="rv">
        <span class="mono">Cómo funciona</span>
        <h2 class="disp" id="como-title">Reservar es <em>simple</em></h2>
      </div>
      <p class="rv d1">
        En la montaña, una cordada avanza al ritmo de quien va más lento. Por eso nuestros grupos son chicos, nuestros guías son de la zona y nadie se queda atrás.
      </p>
    </div>
    <ol class="steps">
      {
        STEPS.map((s, i) => (
          <li class:list={['step', 'rv', i > 0 && `d${i}`]}>
            <div class="step-img">
              <Picture src={photos[i]!} alt={s.alt} formats={['avif', 'webp']} fallbackFormat="webp" widths={[360, 560]} sizes="(min-width: 900px) 290px, 100vw" loading="lazy" />
              <span class="n" aria-hidden="true">{i + 1}</span>
            </div>
            <div class="step-body">
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </div>
          </li>
        ))
      }
    </ol>
    <div class="band rv">
      <Picture
        src={incluido}
        alt="Refugio de montaña en Torres del Paine a la hora azul, con luz en las ventanas y botas en la puerta"
        formats={['avif', 'webp']}
        fallbackFormat="webp"
        widths={[800, 1280, 1800]}
        sizes="(min-width: 1340px) 1240px, 100vw"
        loading="lazy"
        pictureAttributes={{ class: 'band-pic', 'data-parallax': '' }}
      />
      <div class="band-in">
        <span class="mono">Incluido en cada salida</span>
        <h3 class="disp">Tú solo caminas. <em>Del resto nos encargamos.</em></h3>
        <ul>
          {
            INCLUDED.map(([ic, label]) => (
              <li>
                <Image src={icon(ic)} alt="" width={56} height={56} format="webp" loading="lazy" />
                {label}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .how {
    padding: 110px 0;
    background: var(--ink);
    color: #f4f3f8;
    border-radius: 40px 40px 0 0;
  }
  .how .mono {
    color: var(--accent-2);
  }
  .head {
    display: grid;
    gap: 18px;
    margin-bottom: 44px;
  }
  h2 {
    max-width: 14ch;
    margin: 12px 0 0;
    font-size: clamp(44px, 5.4vw, 84px);
  }
  em {
    font-style: normal;
    color: var(--accent-2);
  }
  .head p {
    max-width: 44ch;
    margin: 0;
    color: rgb(244 243 248 / 0.75);
  }
  .steps {
    display: grid;
    gap: 14px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .step {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-radius: var(--radius);
    background: rgb(255 255 255 / 0.05);
    border: 1px solid rgb(255 255 255 / 0.1);
    transition:
      background-color 0.3s,
      transform 0.4s var(--ease);
  }
  .step:hover {
    background: rgb(255 255 255 / 0.09);
    transform: translateY(-4px);
  }
  .step-img {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
  }
  .step-img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.9);
    transition:
      transform 1.1s var(--ease),
      filter 0.5s;
  }
  .step:hover .step-img :global(img) {
    transform: scale(1.07);
    filter: none;
  }
  .step-img::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 50%, rgb(22 21 29 / 0.55));
  }
  .n {
    position: absolute;
    left: 16px;
    bottom: 16px;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: var(--accent);
    font-family: var(--f-display);
    font-weight: 700;
    font-size: 20px;
  }
  .step-body {
    padding: 20px 22px 24px;
  }
  h3 {
    margin: 0 0 8px;
    font-family: var(--f-display);
    font-weight: 700;
    font-size: 24px;
    line-height: 1.1;
  }
  .step-body p {
    margin: 0;
    font-size: 15px;
    color: rgb(244 243 248 / 0.75);
  }
  .band {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: flex-end;
    min-height: 380px;
    margin-top: 18px;
    overflow: hidden;
    border-radius: var(--radius);
  }
  .band :global(.band-pic) {
    position: absolute;
    inset: -12% 0;
    z-index: -2;
  }
  .band :global(.band-pic img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .band::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(90deg, rgb(22 21 29 / 0.88), rgb(22 21 29 / 0.45) 70%, rgb(22 21 29 / 0.15));
  }
  .band-in {
    max-width: 760px;
    padding: clamp(26px, 4vw, 48px);
  }
  .band h3 {
    margin: 10px 0 20px;
    font-size: clamp(32px, 3.6vw, 54px);
    line-height: 0.98;
  }
  .band ul {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .band li {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 5px 14px 5px 5px;
    border-radius: 12px;
    background: rgb(22 21 29 / 0.4);
    border: 1px solid rgb(255 255 255 / 0.18);
    font-size: 14px;
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
  }
  .band li :global(img) {
    width: 30px;
    height: 30px;
  }
  @media (min-width: 900px) {
    .head {
      grid-template-columns: 1fr 1fr;
      align-items: end;
    }
    .steps {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  @media (min-width: 560px) and (max-width: 899px) {
    .steps {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
