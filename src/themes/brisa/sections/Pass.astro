---
/** Pase de temporada: aviso de nuevas salidas (formulario de demo). */
import { getImage } from 'astro:assets';
import bg from '@/assets/img/brisa/pase-temporada.png';
import DemoForm from '../components/DemoForm.astro';

const img = await getImage({ src: bg, width: 1100, format: 'webp', quality: 70 });
---

<section class="pass-sec" aria-labelledby="pass-title">
  <div class="wrap">
    <div class="pass rv">
      <div class="l" style={`--bg-img:url(${img.src})`}>
        <span class="mono">Pase de temporada · 2026–27</span>
        <h2 class="disp" id="pass-title">La próxima salida te espera</h2>
        <p>Te avisamos cuando se abren fechas y cupos. Una vez al mes, sin spam.</p>
      </div>
      <div class="r">
        <DemoForm id="br-mail-2" label="Tu correo" placeholder="nombre@correo.com" button="Quiero mi pase" dark />
      </div>
    </div>
  </div>
</section>

<style>
  .pass-sec {
    padding: 20px 0 clamp(80px, 10vw, 130px);
  }
  .pass {
    display: grid;
    max-width: 1000px;
    margin: 0 auto;
    background: var(--mustard);
    border: 2px solid var(--ink);
    box-shadow: 8px 8px 0 var(--ink);
  }
  /* Ilustración de fondo (rayos y cordillera); un leve giro de tono lleva sus franjas a mostaza */
  .l {
    position: relative;
    isolation: isolate;
    /* Abajo queda espacio para la cordillera del fondo: el texto no la pisa */
    padding: clamp(60px, 7vw, 90px) clamp(28px, 4vw, 48px) clamp(120px, 13vw, 170px);
    border-bottom: 2px dashed var(--ink);
    color: var(--cream);
    background: var(--forest);
  }
  .l::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--bg-img) center / cover;
    filter: hue-rotate(6deg) saturate(0.9);
  }
  .l .mono {
    display: inline-block;
    padding: 4px 10px;
    background: var(--forest);
    color: var(--mustard);
  }
  h2 {
    margin: 12px 0 0;
    font-size: clamp(48px, 5.6vw, 88px);
    text-shadow: 3px 3px 0 var(--forest);
  }
  .l p {
    max-width: 36ch;
    margin: 12px 0 0;
    color: var(--cream);
  }
  .r {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(28px, 4vw, 48px);
  }
  .r :global(label) {
    color: var(--ink);
  }
  @media (min-width: 900px) {
    .pass {
      grid-template-columns: 1.3fr 1fr;
    }
    .l {
      border-bottom: 0;
      border-right: 2px dashed var(--ink);
    }
  }
</style>
