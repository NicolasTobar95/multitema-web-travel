---
/**
 * "Circuito W en detalle" (sección oscura): cifras con cambio de unidades,
 * vista del recorrido (póster con acercamiento lento en CSS, reemplaza el video)
 * y perfil de elevación interactivo. El trazado del perfil se genera en el build.
 */
import { Picture } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import detalle from '@/assets/img/cordada/detalle-w.jpg';
import poster from '@/assets/img/cordada/recorrido-w-poster.webp';
import { num, usd } from '@/lib/format';
import Topo from '../components/Topo.astro';
import { coord, pad2 } from '../data';
import { PF, PROFILE_KM, WAYPOINTS, pfX, pfY, profileSamples } from '../lib/geo';

interface Props {
  trip: CollectionEntry<'trips'>['data'];
}
const { trip } = Astro.props;

const samples = profileSamples();
const line = samples.map((e, i) => `${i ? 'L' : 'M'}${pfX(i / 4).toFixed(1)},${pfY(e).toFixed(1)}`).join('');
const area = `${line}L${pfX(PROFILE_KM)},${pfY(0)}L${pfX(0)},${pfY(0)}Z`;
const at = (km: number) => samples[Math.round(km * 4)] ?? 0;
const maxM = trip.maxAltitudeM ?? 880;
const km = trip.distanceKm ?? PROFILE_KM;
---

<section class="deep" id="detalle" data-coord={coord(trip.coords!)} data-circuit>
  <Picture src={detalle} alt="" formats={['avif', 'webp']} fallbackFormat="webp" width={1600} widths={[800, 1600]} sizes="100vw" loading="lazy" class="ghost" pictureAttributes={{ class: 'ghost', 'aria-hidden': 'true' }} />
  <Topo peaks={[[1250, 300, 2.6], [250, 850, 1.4]]} rings={16} step={38} class="deep-topo" />
  <div class="wrap">
    <div class="head">
      <div class="rv">
        <span class="mono eyebrow">Ruta 03 en detalle</span>
        <h2 class="display">Circuito W en detalle</h2>
      </div>
      <div class="rv d1">
        <p>
          Subidas cortas pero exigentes, largos tramos junto a los lagos y un solo gran desnivel: los {num(maxM)} m de la subida a la base de las Torres. Así se ve cada día del recorrido.
        </p>
        <div class="units" role="group" aria-label="Unidades de medida">
          <button type="button" data-units="metric" aria-pressed="true">KM · M</button>
          <button type="button" data-units="imperial" aria-pressed="false">MI · FT</button>
        </div>
      </div>
    </div>

    <div class="dgrid rv">
      <div class="cell"><span class="mono">Días</span><b>{pad2(trip.days)}</b></div>
      <div class="cell">
        <span class="mono">Distancia</span><b><span data-dist={km}>{km}</span><small data-dist-unit>km</small></b>
      </div>
      <div class="cell">
        <span class="mono">Elevación máx.</span><b><span data-elev={maxM}>{num(maxM)}</span><small data-elev-unit>m</small></b>
      </div>
      <figure class="cell film">
        <Picture src={poster} alt="Vista aérea del sendero junto al Lago Pehoé, con los Cuernos del Paine al fondo" formats={['avif', 'webp']} fallbackFormat="webp" width={720} widths={[480, 720]} sizes="(min-width: 1000px) 25vw, 50vw" loading="lazy" />
        <figcaption><b>El recorrido</b><span class="mono">Lago Pehoé → Cuernos</span></figcaption>
      </figure>
      <div class="cell pf">
        <div class="pf-top">
          <span class="mono">Perfil de elevación GPS · Circuito W</span>
          <span class="pf-read" aria-live="off" data-pf-read><span aria-hidden="true">●</span> {km} km · {at(PROFILE_KM)} m</span>
        </div>
        <svg viewBox={`0 0 ${PF.W} ${PF.H}`} role="img" aria-label={`Perfil de elevación del Circuito W: ${km} km, de 60 a ${maxM} metros`} data-pf data-samples={JSON.stringify(samples)}>
          <defs>
            <linearGradient id="pfg" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#2F6FDB" stop-opacity=".5"></stop>
              <stop offset="1" stop-color="#2F6FDB" stop-opacity="0"></stop>
            </linearGradient>
          </defs>
          <g class="grid">
            {
              [0, 250, 500, 750, 1000].map((m) => (
                <>
                  <line x1={PF.l} x2={PF.W - PF.r} y1={pfY(m)} y2={pfY(m)} />
                  <text x={PF.l - 8} y={pfY(m) + 4} text-anchor="end" data-y-label={m}>
                    {num(m)}
                  </text>
                </>
              ))
            }
            {
              [0, 20, 40, 60, 80].map((k) => (
                <text x={pfX(k)} y={PF.H - 8} text-anchor={k === 0 ? 'start' : k === PROFILE_KM ? 'end' : 'middle'} data-x-label={k}>
                  {k} km
                </text>
              ))
            }
          </g>
          <path class="area" d={area}></path>
          <path class="line" d={line}></path>
          {
            WAYPOINTS.map((w) => {
              const x = pfX(w.km);
              const y = pfY(at(w.km));
              return (
                <g class="wp">
                  <circle cx={x} cy={y} r="5" />
                  <text x={x} y={y - 26} text-anchor="middle">
                    {w.day.toUpperCase()}
                  </text>
                  <text x={x} y={y - 12} text-anchor="middle" class="wn">
                    {w.name}
                  </text>
                </g>
              );
            })
          }
          <g class="cur" data-pf-cur>
            <line x1={pfX(PROFILE_KM)} x2={pfX(PROFILE_KM)} y1={PF.t - 10} y2={PF.H - PF.b}></line>
            <circle cx={pfX(PROFILE_KM)} cy={pfY(at(PROFILE_KM))} r="6"></circle>
          </g>
          <rect x={PF.l} y="0" width={PF.W - PF.l - PF.r} height={PF.H} fill="transparent" data-pf-hit></rect>
        </svg>
      </div>
    </div>

    <div class="buy rv">
      <div>
        <span class="mono">Incluye</span>
        <p>Guía bilingüe · Refugios y comidas · Traslados desde Puerto Natales · Entrada al parque · Seguro de viaje</p>
      </div>
      <a class="btn" href="#contacto">Reservar el Circuito W · {usd(trip.priceFrom)}</a>
    </div>
  </div>
</section>

<style>
  .deep {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: clamp(100px, 12vw, 160px) 0;
    background: var(--dark);
    color: var(--on-dark);
  }
  .deep :global(picture.ghost img) {
    opacity: 0.3;
  }
  .deep :global(.deep-topo) {
    z-index: -1;
    --topo-stroke: rgb(233 238 234 / 0.08);
    --topo-index: rgb(47 111 219 / 0.35);
  }
  .head {
    display: grid;
    gap: 26px;
    margin-bottom: 40px;
  }
  .eyebrow {
    color: var(--accent-on-dark);
  }
  h2 {
    font-size: clamp(56px, 7.6vw, 128px);
    margin-top: 10px;
  }
  .head p {
    max-width: 52ch;
    font-weight: 300;
    color: rgb(233 238 234 / 0.8);
  }
  .units {
    display: inline-flex;
    margin-top: 20px;
    padding: 3px;
    border: 1px solid var(--dark-line);
  }
  .units button {
    min-height: 40px;
    padding: 0 14px;
    font-family: var(--f-mono);
    font-size: 12px;
    color: var(--on-dark-muted);
  }
  .units button[aria-pressed='true'] {
    background: var(--on-dark);
    color: var(--dark);
  }
  .units button:focus-visible {
    outline-color: var(--accent-on-dark);
  }
  .dgrid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    background: var(--dark-line);
    border: 1px solid var(--dark-line);
  }
  .cell {
    margin: 0;
    padding: 22px;
    background: var(--dark);
  }
  .cell .mono {
    color: var(--on-dark-muted);
    font-size: 11px;
  }
  .cell b {
    display: block;
    margin-top: 12px;
    font-family: var(--f-display);
    font-size: clamp(54px, 6vw, 92px);
    line-height: 1;
  }
  .cell small {
    margin-left: 4px;
    font-family: var(--f-mono);
    font-size: 13px;
    color: var(--on-dark-muted);
  }
  .film {
    position: relative;
    overflow: hidden;
    min-height: 170px;
    padding: 0;
    display: flex;
  }
  .film :global(picture),
  .film :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .film :global(img) {
    animation: drift 24s ease-in-out infinite alternate;
  }
  @keyframes drift {
    from {
      transform: scale(1);
    }
    to {
      transform: scale(1.14) translate(-3%, -2%);
    }
  }
  .film figcaption {
    position: relative;
    align-self: flex-end;
    width: 100%;
    padding: 40px 22px 18px;
    background: linear-gradient(transparent, rgb(11 20 24 / 0.85));
  }
  .film figcaption b {
    margin: 0;
    font-family: var(--f-body);
    font-size: 17px;
    font-weight: 500;
  }
  .pf {
    grid-column: 1 / -1;
  }
  .pf-top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 10px;
    margin-bottom: 8px;
  }
  .pf-read {
    font-family: var(--f-mono);
    font-size: 13px;
    font-variant-numeric: tabular-nums;
  }
  .pf-read span {
    color: var(--accent-on-dark);
  }
  svg[data-pf] {
    display: block;
    width: 100%;
    height: auto;
    cursor: crosshair;
    touch-action: pan-y;
  }
  .grid line {
    stroke: var(--dark-line);
  }
  .grid text,
  .wp .wn {
    fill: var(--on-dark-muted);
    font-family: var(--f-mono);
    font-size: 11px;
  }
  .area {
    fill: url(#pfg);
  }
  .line {
    fill: none;
    stroke: var(--accent);
    stroke-width: 2;
    stroke-linejoin: round;
  }
  .wp circle {
    fill: var(--dark);
    stroke: var(--on-dark);
    stroke-width: 2;
  }
  .wp text {
    fill: var(--on-dark);
    font-family: var(--f-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
  }
  .cur line {
    stroke: var(--on-dark);
    stroke-dasharray: 3 4;
  }
  .cur circle {
    fill: var(--accent);
    stroke: var(--on-dark);
    stroke-width: 2;
  }
  .buy {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-top: 18px;
    padding: 22px;
    border: 1px solid var(--dark-line);
    background: rgb(11 20 24 / 0.6);
  }
  .buy .mono {
    color: var(--on-dark-muted);
    font-size: 11px;
  }
  .buy p {
    margin-top: 4px;
  }
  @media (min-width: 1000px) {
    .head {
      grid-template-columns: 1fr 1fr;
      align-items: end;
    }
    .dgrid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
