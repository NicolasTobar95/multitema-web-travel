---
/**
 * Header fijo de Cordada: transparente sobre el hero y sólido al bajar.
 * Muestra la coordenada de la sección en pantalla y una barra de progreso.
 * En móvil, el menú se abre con un botón (disclosure).
 */
import LikeButton from '@/components/shared/LikeButton.astro';
import { AGENCY } from '@/lib/catalog';
import { NAV } from '../data';

interface Props {
  coord: string;
}
const { coord } = Astro.props;
---

<header class="hdr" data-hdr>
  <div class="wrap row">
    <a href="#inicio" class="logo" aria-label={`${AGENCY.name}, inicio`} transition:name="brand">
      <svg viewBox="0 0 32 32" fill="none" aria-hidden="true">
        <path d="M2 27L11 10l5 8 4-6 10 15z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"></path>
        <path d="M6 20c4-3 8 3 12 0s7-2 9 1" stroke="var(--accent)" stroke-width="1.8" stroke-dasharray="2.5 2.5" stroke-linecap="round"></path>
        <circle cx="11" cy="10" r="2" fill="var(--accent)"></circle>
      </svg>
      {AGENCY.name.toUpperCase()}
    </a>
    <nav class="nav" id="cd-nav" aria-label="Principal">
      {NAV.map(([href, label]) => <a href={href}>{label}</a>)}
    </nav>
    <span class="coord" data-hdr-coord>{coord}</span>
    <LikeButton class="pill" />
    <a class="cta" href="#expediciones">Reservar</a>
    <button class="menu" type="button" aria-expanded="false" aria-controls="cd-nav" data-menu>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
      <span class="sr-only">Menú</span>
    </button>
  </div>
  <div class="progress" data-progress></div>
</header>

<style>
  .hdr {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    height: 68px;
    display: flex;
    align-items: center;
    color: var(--on-dark);
    transition:
      background-color 0.4s,
      color 0.4s;
  }
  .hdr:global(.solid) {
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    color: var(--ink);
    box-shadow: 0 1px 0 var(--line);
  }
  /* Sin JS no se sabe dónde está el scroll: header sólido siempre */
  @media (scripting: none) {
    .hdr {
      background: var(--bg);
      color: var(--ink);
      box-shadow: 0 1px 0 var(--line);
    }
  }
  .row {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .logo {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-right: 28px;
    font-family: var(--f-display);
    font-weight: 700;
    font-size: 22px;
    letter-spacing: 0.16em;
    text-decoration: none;
  }
  .logo svg {
    width: 26px;
    height: 26px;
  }
  .nav {
    display: none;
    gap: 30px;
    font-size: 14px;
    font-weight: 500;
  }
  .nav a {
    opacity: 0.85;
    text-decoration: none;
  }
  .nav a:hover {
    opacity: 1;
    color: var(--accent);
  }
  .coord {
    margin-left: auto;
    font-family: var(--f-mono);
    font-size: 12px;
    opacity: 0.8;
    display: none;
  }
  .hdr :global(.pill) {
    display: none;
    min-height: 38px;
    border-color: color-mix(in srgb, currentColor 28%, transparent);
  }
  .hdr :global(.pill svg) {
    color: var(--accent);
  }
  .cta {
    display: none;
    align-items: center;
    min-height: 38px;
    padding: 0 16px;
    border-radius: 3px;
    background: var(--accent);
    color: #fff;
    font-family: var(--f-mono);
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
  }
  .cta:hover {
    background: var(--accent-hover);
  }
  .menu {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    margin-left: auto;
    border-radius: 3px;
  }
  .menu svg {
    width: 22px;
    height: 22px;
  }
  .progress {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 2px;
    background: var(--accent);
    transform-origin: 0 50%;
    transform: scaleX(0);
  }
  @media (min-width: 600px) {
    .hdr :global(.pill) {
      display: inline-flex;
    }
    .coord {
      display: block;
    }
    .menu {
      margin-left: 0;
    }
  }
  @media (min-width: 700px) {
    .cta {
      display: inline-flex;
    }
  }
  @media (min-width: 900px) {
    .nav {
      display: flex;
    }
    .menu {
      display: none;
    }
  }
  /* Menú abierto en móvil */
  @media (max-width: 899px) {
    .nav:global(.open) {
      position: absolute;
      top: 68px;
      left: 0;
      right: 0;
      display: grid;
      gap: 0;
      padding: 8px 16px 16px;
      background: var(--bg);
      color: var(--ink);
      box-shadow: 0 1px 0 var(--line);
    }
    .nav:global(.open) a {
      padding: 14px 0;
      border-bottom: 1px solid var(--line);
      font-size: 17px;
    }
  }
</style>
