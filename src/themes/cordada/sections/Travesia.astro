---
/**
 * Infografía de la Gran Travesía: hoja de mapa con la costa real (Natural Earth
 * 1:50m, generada en el build) y la ruta Pumalín → Cerro Castillo → Torres del
 * Paine, que se dibuja al entrar en pantalla. A la derecha, las etapas.
 * Los km de cada traslado reparten el total por carretera (trips.json) según la
 * distancia en línea recta de cada tramo.
 */
import type { CollectionEntry } from 'astro:content';
import { num, usd } from '@/lib/format';
import Topo from '../components/Topo.astro';
import { coord, ROUTES } from '../data';
import { buildMap, haversine, MAP_H, MAP_W } from '../lib/geo';

type Trip = CollectionEntry<'trips'>['data'];
interface Props {
  trips: Map<string, Trip>;
  travesia: Trip;
}
const { trips, travesia } = Astro.props;

const stops = ROUTES.map((r) => {
  const t = trips.get(r.id)!;
  return { ...r, lat: t.coords!.lat, lon: t.coords!.lon, days: t.days };
});
const map = buildMap(stops);
const total = travesia.transfersKm ?? 923;
const straight = stops.slice(1).map((s, i) => haversine(stops[i]!, s));
const sum = straight.reduce((a, b) => a + b, 0);
const legs = straight.map((d) => Math.round((d / sum) * total));
---

<section class="info" id="ruta" data-travesia data-legs={JSON.stringify(legs)}>
  <Topo peaks={[[200, 250, 3.1], [1400, 800, 0.9]]} rings={14} step={40} class="info-topo" />
  <div class="wrap">
    <div class="head">
      <div class="rv">
        <span class="eyebrow mono"><i></i>Gran Travesía · {travesia.days} días</span>
        <h2 class="display" transition:name="trip-travesia">Las tres rutas en un solo viaje</h2>
      </div>
      <p class="rv d1">
        De los bosques de Pumalín a las Torres del Paine, de norte a sur por la Carretera Austral. Quince días, tres rutas guiadas y todos los traslados entre ellas.
      </p>
    </div>

    <div class="grid">
      <div class="sheet rv">
        <span class="tl">Hoja CD-01 · Gran Travesía</span><span class="tr">39° S</span><span class="bl">80° W</span><span class="br">N ↑ · Natural Earth 1:50m</span>
        <svg viewBox={`0 0 ${MAP_W} ${MAP_H}`} role="img" aria-label="Mapa de la Patagonia chilena con la ruta de Pumalín a Cerro Castillo y a Torres del Paine" data-map>
          <path class="grat" d={map.graticule}></path>
          <path class="land" d={map.land}></path>
          {map.legs.map((d) => <path class="ghost-route" d={d} />)}
          {map.legs.map((d, i) => <path class="route" d={d} pathLength="1" data-leg={i} />)}
          {
            stops.map((s, i) => (
              <g class="pt" transform={`translate(${map.points[i]!.x},${map.points[i]!.y})`} data-pt={i}>
                <circle class="halo" r="12" />
                <rect class="mk" x="-12" y="-12" width="24" height="24" />
                <text class="n" text-anchor="middle" y="4">
                  {i + 1}
                </text>
                <text class="l" x="24" y="-2">
                  {s.name}
                </text>
                <text class="c" x="24" y="15">
                  {coord(s)}
                </text>
              </g>
            ))
          }
        </svg>
        <span class="read" aria-hidden="true">Recorrido <b data-map-read>{num(total)} km</b></span>
        <div class="scale" aria-hidden="true">
          <div class="bar" style={`width:${(map.scale200 * 100).toFixed(2)}%`}><i></i><i></i><i></i><i></i></div>
          <span>0 · 100 · 200 km</span>
        </div>
      </div>

      <ol class="facts rv d1" data-facts>
        {
          stops.map((s, i) => (
            <li data-i={i}>
              <span class="n" aria-hidden="true">{i + 1}</span>
              <b>{s.name}</b>
              <small>
                {coord(s)} · {s.days} días · {s.subtitle}
              </small>
              {i === 0 ? (
                <span class="hop">Inicio en Chaitén</span>
              ) : (
                <span class="hop">
                  Traslado {i}: <span data-km={legs[i - 1]}>{num(legs[i - 1]!)} km</span>
                  <i style="--f:1" />
                </span>
              )}
            </li>
          ))
        }
        <li class="tot">
          <span class="mono">Distancia total entre rutas</span>
          <b data-km={total}>{num(total)} km</b>
          <span class="mono price-label">Desde, por persona</span>
          <b class="price">{usd(travesia.priceFrom)}</b>
          <a class="btn" href="#contacto">Reservar la Gran Travesía</a>
        </li>
      </ol>
    </div>
  </div>
</section>

<style>
  .info {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: clamp(100px, 11vw, 150px) 0;
    background: var(--bg-2);
  }
  .info :global(.info-topo) {
    z-index: -1;
    opacity: 0.6;
  }
  .head {
    display: grid;
    gap: 20px;
    margin-bottom: 34px;
  }
  .eyebrow {
    display: flex;
    align-items: center;
    gap: 12px;
    color: var(--accent);
  }
  .eyebrow i {
    width: 30px;
    height: 1px;
    background: var(--accent);
  }
  h2 {
    font-size: clamp(52px, 6.6vw, 108px);
    margin-top: 10px;
  }
  .head p {
    max-width: 44ch;
    color: var(--ink-2);
  }
  .grid {
    display: grid;
    gap: 18px;
  }
  .sheet {
    position: relative;
    padding: 22px;
    background: var(--card);
    border: 1px solid var(--ink);
  }
  .sheet::before {
    content: '';
    position: absolute;
    inset: 8px;
    border: 1px solid var(--line);
    pointer-events: none;
  }
  .sheet svg {
    display: block;
    width: 100%;
    height: auto;
  }
  .tl,
  .tr,
  .bl,
  .br {
    position: absolute;
    padding: 0 6px;
    background: var(--card);
    font-family: var(--f-mono);
    font-size: 10.5px;
    letter-spacing: 0.08em;
    color: var(--muted);
  }
  .tl {
    left: 22px;
    top: 2px;
  }
  .tr {
    right: 22px;
    top: 2px;
  }
  .bl {
    left: 22px;
    bottom: 2px;
  }
  .br {
    right: 22px;
    bottom: 2px;
  }
  .read {
    position: absolute;
    right: 34px;
    top: 34px;
    padding: 6px 10px;
    border-radius: 2px;
    background: var(--ink);
    color: #fff;
    font-family: var(--f-mono);
    font-size: 12px;
  }
  .read b {
    color: var(--accent-on-dark);
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }
  .scale {
    position: absolute;
    left: 34px;
    bottom: 34px;
    width: calc(100% - 68px);
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-family: var(--f-mono);
    font-size: 10.5px;
    color: var(--muted);
  }
  .scale .bar {
    display: flex;
    height: 5px;
    border: 1px solid var(--ink);
  }
  .scale .bar i {
    flex: 1;
  }
  .scale .bar i:nth-child(odd) {
    background: var(--ink);
  }
  .grat {
    fill: none;
    stroke: var(--line);
    stroke-width: 0.6;
  }
  .land {
    fill: rgb(15 26 32 / 0.07);
    stroke: rgb(15 26 32 / 0.32);
    stroke-width: 0.5;
  }
  .ghost-route {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1;
    stroke-dasharray: 2 4;
    opacity: 0.3;
  }
  .route {
    fill: none;
    stroke: var(--accent);
    stroke-width: 3;
    stroke-linecap: round;
  }
  .halo {
    fill: var(--accent);
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
  }
  .pt:global(.on) .halo {
    animation: halo 2.2s infinite;
  }
  @keyframes halo {
    0% {
      transform: scale(0.6);
      opacity: 0.35;
    }
    100% {
      transform: scale(2.8);
      opacity: 0;
    }
  }
  .pt {
    transition: opacity 0.4s;
  }
  .mk {
    fill: var(--ink);
    transition: fill 0.3s;
  }
  .pt:global(.on) .mk {
    fill: var(--accent);
  }
  .n {
    fill: #fff;
    font-family: var(--f-mono);
    font-size: 12px;
    font-weight: 500;
  }
  .l {
    fill: var(--ink);
    font-family: var(--f-display);
    font-size: 22px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }
  .c {
    fill: var(--muted);
    font-family: var(--f-mono);
    font-size: 11px;
  }
  /* Animación de la ruta: el JS marca la sección con .armed al cargar (sin JS
     o con movimiento reducido se ve el mapa completo desde el inicio). */
  .info:global(.armed) .route {
    stroke-dasharray: 1;
    stroke-dashoffset: var(--p, 1);
  }
  .info:global(.armed) .pt:not(:global(.show)) {
    opacity: 0;
  }
  .info:global(.armed) .facts li[data-i]:not(:global(.on)) {
    opacity: 0.45;
  }
  .facts {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
    list-style: none;
    border: 1px solid var(--ink);
    background: var(--card);
  }
  .facts li {
    display: grid;
    grid-template-columns: 34px 1fr;
    gap: 2px 12px;
    padding: 16px 18px;
    border-bottom: 1px solid var(--line);
    transition:
      background-color 0.3s,
      opacity 0.3s;
  }
  .facts li:hover,
  .facts li:global(.hl) {
    background: var(--accent-soft);
  }
  .facts .n {
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    margin-top: 2px;
    background: var(--accent);
    color: #fff;
  }
  .facts b {
    font-family: var(--f-display);
    font-size: 24px;
    font-weight: 700;
    line-height: 1.05;
    text-transform: uppercase;
  }
  .facts small,
  .facts .hop {
    grid-column: 2;
    font-family: var(--f-mono);
    font-size: 12px;
    color: var(--muted);
  }
  .facts .hop {
    margin-top: 6px;
    color: var(--ink-2);
  }
  .facts .hop i {
    position: relative;
    display: block;
    height: 3px;
    margin-top: 6px;
    overflow: hidden;
    background: var(--line);
  }
  .facts .hop i::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--accent);
    transform-origin: 0 50%;
    transform: scaleX(var(--f, 0));
  }
  .facts .tot {
    display: block;
    margin-top: auto;
    border-bottom: 0;
  }
  .tot .mono {
    display: block;
    font-size: 11px;
    color: var(--muted);
  }
  .tot b {
    display: block;
    margin-top: 4px;
    font-size: 52px;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .tot .price-label {
    margin-top: 14px;
  }
  .tot .price {
    font-size: 40px;
    color: var(--accent);
  }
  .tot :global(.btn) {
    width: 100%;
    margin-top: 14px;
  }
  @media (max-width: 599px) {
    .l {
      font-size: 30px;
    }
    .c {
      font-size: 16px;
    }
    .read {
      right: 22px;
      top: 22px;
    }
  }
  @media (min-width: 1000px) {
    .head {
      grid-template-columns: 1fr 1fr;
      align-items: end;
    }
    .grid {
      grid-template-columns: 1fr 320px;
    }
  }
</style>
