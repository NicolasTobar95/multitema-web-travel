---
/**
 * Hero de Cordada: foto (escritorio / móvil), curvas de nivel que se dibujan,
 * HUD con la altitud de la base de las Torres y datos clave.
 */
import { getImage } from 'astro:assets';
import heroDesktop from '@/assets/img/cordada/hero.jpg';
import heroMobile from '@/assets/img/cordada/hero-movil.webp';
import { AGENCY } from '@/lib/catalog';
import { usd } from '@/lib/format';
import Topo from '../components/Topo.astro';

interface Props {
  routes: number;
  priceFrom: number;
  coord: string;
}
const { routes, priceFrom, coord } = Astro.props;

const widths = [960, 1440, 1920];
const desk = await Promise.all(widths.map((w) => getImage({ src: heroDesktop, width: Math.min(w, heroDesktop.width), format: 'avif' })));
const deskWebp = await Promise.all(widths.map((w) => getImage({ src: heroDesktop, width: Math.min(w, heroDesktop.width), format: 'webp' })));
const mob = await getImage({ src: heroMobile, width: 800, format: 'avif' });
const mobWebp = await getImage({ src: heroMobile, width: 800, format: 'webp' });
const srcset = (imgs: Awaited<ReturnType<typeof getImage>>[]) => imgs.map((i) => `${i.src} ${i.attributes['width']}w`).join(', ');
const alt = 'Un grupo de caminantes avanza en fila por una cresta hacia las Torres del Paine, antes del amanecer';
---

<section class="hero" id="inicio" data-coord={coord}>
  <picture class="bg">
    <source media="(max-width: 699px)" type="image/avif" srcset={mob.src} />
    <source media="(max-width: 699px)" type="image/webp" srcset={mobWebp.src} />
    <source type="image/avif" srcset={srcset(desk)} sizes="100vw" />
    <img src={deskWebp[1]!.src} srcset={srcset(deskWebp)} sizes="100vw" alt={alt} width={heroDesktop.width} height={heroDesktop.height} fetchpriority="high" decoding="async" />
  </picture>
  <Topo peaks={[[1180, 380, 1.2], [300, 900, 3.4]]} rings={16} step={34} draw class="hero-topo" />

  <div class="hud" aria-hidden="true">
    <svg viewBox="0 0 180 180">
      <circle class="ring" cx="90" cy="90" r="88" stroke-dasharray="2 6"></circle>
      <g class="spin"><circle class="ring" cx="90" cy="90" r="64" stroke-dasharray="40 14"></circle></g>
      <circle class="ring" cx="90" cy="90" r="30"></circle>
      <path class="tick" d="M90 0v24M90 156v24M0 90h24M156 90h24"></path>
      <circle cx="90" cy="90" r="5" fill="var(--accent)"></circle>
    </svg>
    <div class="read">
      <span>Base Torres · ALT</span>
      <b data-hud-alt data-to="880">0880 m</b>
      <span data-hud-lat data-to="50.97">50.9700° S</span><br /><span data-hud-lon data-to="72.97">72.9700° W</span>
    </div>
  </div>

  <div class="wrap inner">
    <p class="eyebrow mono"><i></i>Trekking guiado · Patagonia chilena · Temporada 2026–27</p>
    <h1 class="display" transition:name="hero-title">
      <span class="ln"><span>Patagonia</span></span><span class="ln"><span>sin <em>atajos</em></span></span>
    </h1>
    <div class="row">
      <div>
        <p class="lede">
          Caminamos en grupos de máximo {AGENCY.maxGroup} personas, con guías locales y todo resuelto: traslados, refugios, comidas y permisos. Tú solo te preocupas de caminar.
        </p>
        <div class="ctas">
          <a class="btn" href="#expediciones">Ver próximas salidas</a>
          <a class="btn btn-ghost" href="#ruta">Gran Travesía · 15 días</a>
        </div>
      </div>
      <div class="scale" aria-hidden="true">
        <span>Escala 1 : 50.000</span>
        <div class="bar"><i></i><i></i><i></i><i></i></div>
        <div class="lbl"><span>0</span><span>1</span><span>2 km</span></div>
      </div>
    </div>
    <dl class="meta">
      <div><dt class="mono">Rutas guiadas</dt><dd>{String(routes).padStart(2, '0')}</dd></div>
      <div><dt class="mono">Personas máx. por grupo</dt><dd>{AGENCY.maxGroup}</dd></div>
      <div><dt class="mono">Temporada</dt><dd>Oct–Abr</dd></div>
      <div><dt class="mono">Desde, por persona</dt><dd>{usd(priceFrom)}</dd></div>
    </dl>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    min-height: 100svh;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    background: var(--dark);
    color: var(--on-dark);
  }
  .bg {
    position: absolute;
    inset: 0;
    z-index: -3;
  }
  .bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.72;
    transform: scale(1.06);
    animation: kb 3s var(--ease) forwards;
  }
  @keyframes kb {
    to {
      transform: scale(1);
    }
  }
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -2;
    background: linear-gradient(180deg, rgb(11 20 24 / 0.55), rgb(11 20 24 / 0.1) 35%, rgb(11 20 24 / 0.92));
  }
  .hero :global(.hero-topo) {
    z-index: -1;
    --topo-stroke: rgb(233 238 234 / 0.28);
    --topo-index: rgb(233 238 234 / 0.5);
  }
  .hud {
    position: absolute;
    /* La lectura va a la derecha del anillo (~150 px): que no se salga de la pantalla */
    right: max(9vw, 190px);
    top: 30vh;
    width: 180px;
    height: 180px;
    display: none;
  }
  .hud svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .ring {
    fill: none;
    stroke: var(--on-dark);
    stroke-width: 1;
    opacity: 0.7;
  }
  .tick {
    stroke: var(--on-dark);
    stroke-width: 1.5;
  }
  .spin {
    transform-origin: 90px 90px;
    animation: spin 14s linear infinite;
  }
  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }
  .read {
    position: absolute;
    left: 100%;
    top: 50%;
    transform: translateY(-50%);
    margin-left: 20px;
    font-family: var(--f-mono);
    font-size: 12px;
    letter-spacing: 0.08em;
    white-space: nowrap;
    line-height: 1.9;
  }
  .read b {
    display: block;
    font-family: var(--f-display);
    font-size: 44px;
    line-height: 1;
    color: #fff;
    font-variant-numeric: tabular-nums;
  }
  .inner {
    padding: 150px 0 40px;
  }
  .eyebrow {
    display: flex;
    gap: 16px;
    align-items: center;
    color: var(--on-dark-muted);
  }
  .eyebrow i {
    flex: 0 0 30px;
    height: 1px;
    background: var(--accent);
  }
  h1 {
    font-size: clamp(64px, 11vw, 196px);
    margin: 14px 0 24px;
  }
  .ln {
    display: block;
    overflow: hidden;
  }
  .ln > span {
    display: inline-block;
    transform: translateY(105%);
    animation: up 1.1s var(--ease) forwards;
  }
  .ln:nth-child(2) > span {
    animation-delay: 0.12s;
  }
  h1 em {
    font-style: normal;
    color: var(--accent);
  }
  @keyframes up {
    to {
      transform: none;
    }
  }
  .row {
    display: grid;
    gap: 30px;
    align-items: end;
  }
  .lede {
    max-width: 540px;
    font-size: clamp(17px, 1.4vw, 20px);
    font-weight: 300;
    color: rgb(233 238 234 / 0.86);
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 26px;
  }
  .scale {
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-family: var(--f-mono);
    font-size: 11px;
    color: var(--on-dark-muted);
  }
  .scale .bar {
    display: flex;
    width: 220px;
    height: 6px;
    border: 1px solid var(--on-dark);
  }
  .scale .bar i {
    flex: 1;
  }
  .scale .bar i:nth-child(odd) {
    background: var(--on-dark);
  }
  .scale .lbl {
    display: flex;
    justify-content: space-between;
  }
  .meta {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    margin: 44px 0 0;
    border-top: 1px solid var(--dark-line);
  }
  .meta div {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    padding: 16px 0 16px 16px;
    border-right: 1px solid var(--dark-line);
  }
  .meta div:nth-child(odd) {
    padding-left: 0;
  }
  .meta dd {
    margin: 0;
    font-family: var(--f-display);
    font-size: 40px;
    line-height: 1;
  }
  .meta dt {
    color: var(--on-dark-muted);
    font-size: 11px;
  }
  @media (max-width: 699px) {
    .inner {
      padding-bottom: 96px;
    }
    .scale {
      display: none;
    }
  }
  @media (min-width: 800px) {
    .meta {
      grid-template-columns: repeat(4, 1fr);
    }
    .meta div:nth-child(odd) {
      padding-left: 16px;
    }
    .meta div:first-child {
      padding-left: 0;
    }
  }
  @media (min-width: 1000px) {
    .hud {
      display: block;
    }
    .inner {
      padding-right: 240px;
    }
    .row {
      grid-template-columns: 1fr auto;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .bg img,
    .ln > span {
      transform: none;
      animation: none;
    }
  }
</style>
