---
/**
 * Fondo de curvas de nivel (SVG estático generado en el build).
 * draw: las curvas se "dibujan" al cargar (solo CSS, con pathLength=1).
 */
import { contours, type Peak } from '../lib/topo';

interface Props {
  peaks: readonly Peak[];
  rings: number;
  step: number;
  height?: number;
  draw?: boolean;
  class?: string;
}
const { peaks, rings, step, height = 1000, draw = false, class: className } = Astro.props;
const paths = contours(peaks, rings, step);
---

<svg class:list={['topo', { draw }, className]} viewBox={`0 0 1600 ${height}`} preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
  {paths.map((p, i) => <path d={p.d} class:list={{ idx: p.index }} pathLength="1" style={draw ? `--i:${i}` : undefined} />)}
</svg>

<style>
  .topo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  path {
    fill: none;
    stroke: var(--topo-stroke, var(--contour));
    stroke-width: 1;
  }
  path.idx {
    stroke: var(--topo-index, var(--topo-stroke, var(--contour)));
    stroke-width: 1.6;
  }
  .draw path {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: topo-draw 2.4s var(--ease) forwards;
    animation-delay: calc(0.2s + var(--i) * 0.03s);
  }
  @keyframes topo-draw {
    to {
      stroke-dashoffset: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .draw path {
      stroke-dashoffset: 0;
      animation: none;
    }
  }
</style>
