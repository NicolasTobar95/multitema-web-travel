---
/** "Lo que cuentan al volver": los 4 testimonios en la grilla. */
import type { CollectionEntry } from 'astro:content';

interface Props {
  items: CollectionEntry<'testimonials'>[];
}
const { items } = Astro.props;
const stars = (n: number) => '★'.repeat(n) + '☆'.repeat(5 - n);
---

<section id="viajeros" class="voices" aria-labelledby="voices-title">
  <div class="wrap">
    <div class="s-head rv">
      <span class="mono">03 — Viajeros</span>
      <h2 class="big" id="voices-title">Lo que cuentan <span class="grad">al volver</span></h2>
      <p>Cuatro notas del cuaderno de la cordada.</p>
    </div>
    <div class="quotes">
      {
        items.map((t, i) => (
          <figure class="q">
            <span class="no mono">Nota {String(i + 1).padStart(2, '0')}</span>
            <blockquote>“{t.data.quote}”</blockquote>
            <span class="st" role="img" aria-label={`${t.data.rating} de 5 estrellas`}>
              {stars(t.data.rating)}
            </span>
            <figcaption class="who">
              <span class="av" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                  <circle cx="12" cy="8.5" r="3.8" />
                  <path d="M4.5 20c1.2-3.8 4.2-5.8 7.5-5.8s6.3 2 7.5 5.8" />
                </svg>
              </span>
              <span>
                {t.data.name}
                <small>
                  {t.data.trip} · {t.data.city}
                </small>
              </span>
            </figcaption>
          </figure>
        ))
      }
    </div>
    <p class="note mono">Testimonios de ejemplo para el sitio demo.</p>
  </div>
</section>

<style>
  .voices {
    padding: 20px 0 clamp(80px, 10vw, 130px);
  }
  .quotes {
    display: grid;
    border-left: 1px solid var(--line);
  }
  .q {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 24px 22px 26px;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    transition:
      background 0.3s,
      box-shadow 0.3s;
  }
  .q:hover {
    background: var(--glass);
    box-shadow: inset 0 0 0 1px rgb(159 216 255 / 0.35);
  }
  .no {
    font-size: 11px;
    color: var(--gold);
  }
  blockquote {
    margin: 18px 0 22px;
    font-size: 18px;
    line-height: 1.4;
    color: var(--ink-2);
  }
  .st {
    margin-top: auto;
    font-size: 13px;
    letter-spacing: 2px;
    color: var(--gold);
  }
  .who {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 14px;
    font-size: 14px;
    font-weight: 600;
  }
  .who small {
    display: block;
    font-weight: 400;
    font-size: 12.5px;
    color: var(--muted);
  }
  .av {
    flex: none;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 1px solid var(--gline);
    border-radius: 50%;
    background: rgb(159 216 255 / 0.1);
    color: var(--ice);
  }
  .av svg {
    width: 20px;
    height: 20px;
  }
  .note {
    margin: 0;
    padding-top: 14px;
    font-size: 11px;
    color: var(--muted);
  }
  @media (min-width: 700px) {
    .quotes {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1100px) {
    .quotes {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
